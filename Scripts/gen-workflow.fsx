let title = """
# This file is auto-generated by Generaptor.""".Trim()

#r "nuget: Generaptor"
open Generaptor
open Generaptor.GitHubActions
open type Generaptor.GitHubActions.Commands

type Platform =
    | Windows
    | Linux
    | Osx

let allPlatforms = [ Windows; Linux; Osx ]

let runnerImage =
    function
    | Windows -> "windows-2025"
    | Linux -> "ubuntu-24.04"
    | Osx -> "macos-15"

let workflow = [
    let workflow name body = workflow name [
        header title
        yield! body
    ]

    let buildScript = "Scripts/build.fsx"

    let buildCliStep (name: string) (args: string) =
        step(
            name = name,
            run = $"dotnet fsi {buildScript} -- --no-logo {args}"
        )

    let buildTargetStep (name: string) (target: string) =
        buildCliStep name $"--single-target {target}"

    let dotnetVersion = "10.0.402"

    let checkoutAction = Auto "actions/checkout"
    let dotnetSetupAction = Auto "actions/setup-dotnet"
    let cacheAction = Auto "actions/cache"

    let env = [
        setEnv "DOTNET_NOLOGO" "1"
        setEnv "CI" "true"
    ]

    let setUpDotNetSdkStep =
        step(
            name = "Set up .NET SDK",
            usesSpec = dotnetSetupAction,
            options = Map.ofList [
                "dotnet-version", dotnetVersion
            ]
        )

    let checkoutStep =
        step(
            name = "Check out the sources",
            usesSpec = checkoutAction
        )

    let cargoCacheStep =
        step(
            name = "Cache Cargo",
            usesSpec = cacheAction,
            options = Map.ofList [
                "path", "~/.cargo/registry\n~/.cargo/git\nsrc/rslib-bindings/target"
                "key", "${{ runner.os }}.cargo.${{ hashFiles('src/rslib-bindings/Cargo.lock', 'src/rslib-bindings/rust-toolchain.toml', 'paket.lock') }}"
                "restore-keys", "${{ runner.os }}.cargo."
            ]
        )

    workflow "main" [
        name "Build"
        onPushTo "main"
        onPullRequestTo "main"
        onSchedule "0 0 * * 6"
        onWorkflowDispatch

        job "verify" [
            jobName "Verify sources"
            runsOn (runnerImage Linux)
            yield! env
            checkoutStep
            setUpDotNetSdkStep
            buildCliStep "Verify sources" "Verify-Sources"
        ]

        job "build" [
            jobName "Build and test (${{ matrix.image }})"
            strategy(
                matrix = [ ("image", box (allPlatforms |> List.map runnerImage)) ],
                failFast = false
            )
            runsOn "${{ matrix.image }}"
            yield! env
            checkoutStep
            setUpDotNetSdkStep
            cargoCacheStep

            buildTargetStep "Restore" "Restore"
            buildTargetStep "Set up rslib" "Setup-Rslib"
            buildTargetStep "Generate rslib client" "Generate-Rslib-Client"
            buildTargetStep "Generate rslib header" "Generate-Rslib-Header"
            buildTargetStep "Build rslib" "Build-Rslib"
            buildTargetStep "Build solution" "Build-Solution"
            buildTargetStep "Test" "Test"
            buildTargetStep "Test rslib" "Test-Rslib"
        ]
    ]
]

exit <| EntryPoint.Process fsi.CommandLineArgs workflow
